{
  "name": "round-one",
  "version": "4.0.0",
  "private": true,
  "description": "ROUND ONE \u2014 cross-platform daily discipline tracker",
  "main": "electron/main.cjs",
  "scripts": {
    "web": "python3 -m http.server 4173",
    "electron": "npm run build && electron .",
    "electron:dist": "npm run build && electron-builder --win --x64",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:run:android": "npx cap run android",
    "cap:copy": "npx cap copy",
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.roundone.discipline",
    "productName": "ROUND ONE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app.js",
      "style.css",
      "manifest.json",
      "sw.js",
      "icon-192.png",
      "icon-512.png",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
